# Everything is optional: with no variables the app runs fully on local seeded data and mocks.

# AI (photo-to-listing uses a vision model when set; falls back to deterministic mock on any failure)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Razorpay test mode (Checkout + Route). Without keys the mock checkout at /pay/[id] is used.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Supabase (auth + Postgres). Schema and RLS are in supabase/migrations.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server only, never expose to the client

# Demo hosting (no database needed)
DEMO_STATE_SECRET=           # signs the per-visitor demo-state cookie; set a long random value in production
DEMO_MODE=                   # set to "off" to disable the Shopping/Selling/Admin role switcher (use real auth)
NEXT_PUBLIC_SITE_URL=        # used by sitemap.xml
